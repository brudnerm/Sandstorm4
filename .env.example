# Yahoo Fantasy Baseball MCP Configuration
# Copy to ../yahoo-fantasy-baseball-mcp/.env and fill in actual values

# OAuth credentials (from Yahoo Fantasy API)
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_ACCESS_TOKEN=your_access_token_here
YAHOO_REFRESH_TOKEN=your_refresh_token_here

# ============================================================================
# REFRESH STRATEGY
# ============================================================================

# Enable/disable automatic background refresh of current season (2026)
# Default: true (refresh enabled)
AUTO_REFRESH_ENABLED=true

# How often to automatically refresh the current season (2026) in minutes
# Default: 10 (refresh every 10 minutes)
# Set to higher values to reduce API calls (e.g., 30, 60)
REFRESH_CURRENT_SEASON_INTERVAL_MINUTES=10

# Current season year (change for future years)
# Default: 2026
CURRENT_SEASON_YEAR=2026

# Node environment
# Set to 'development' to enable auto-refresh background polling
# Set to 'production' to disable auto-refresh (manual refresh only)
NODE_ENV=development

# ============================================================================
# NOTES
# ============================================================================

# Architecture:
# - Current Season (2026): Auto-refreshes on a background interval
#   Includes: Drafts, Transactions, Team Owners, Projections
#
# - Historical Seasons (2009-2025): Manual refresh only
#   Triggered via /api/refresh-historical endpoint
#   Includes: Drafts, Transactions, Team Owners (No projections)
#
# Endpoints:
# - POST /api/refresh-token              Refresh OAuth token
# - POST /api/refresh-current-season     Manual refresh of 2026 only
# - POST /api/refresh-historical         Manual refresh of 2009-2025
# - POST /api/refresh-all                Full refresh (all seasons)
# - GET  /api/refresh-status             Get refresh status and next scheduled refresh
#
# Data Files:
# - yahoo-fantasy-baseball-mcp/data/all_transactions.json (drafts + transactions)
# - yahoo-fantasy-baseball-mcp/data/all_drafts.json (drafts only)
# - yahoo-fantasy-baseball-mcp/data/refresh_state.json (refresh metadata)
